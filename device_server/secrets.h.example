#ifndef _SECRETS_H_
#define _SECRETS_H_

/* Copy this file to secrets.h and fill in your own keys. secrets.h is gitignored so the
 * real values stay out of the repository; config.h includes it and carries no
 * credentials of its own.
 *
 *   cp secrets.h.example secrets.h
 *
 * Both keys are optional. geolocate_wifi() and geolocate_tower() in web_geolocate.c try
 * HERE first and fall back to Google, so leaving one blank just skips that provider. With
 * both blank the daemon still runs - GPS fixes are unaffected, and WiFi/cell lookups fall
 * back to the nearest known tower in the local cell database. */

/* HERE location services. https://developer.here.com - create a project, then generate a
 * REST API key. */
#define HERE_API_KEY ""

/* Google geolocation API. https://console.cloud.google.com - enable the Geolocation API
 * and create an API key. */
#define GOOGLE_API_KEY ""

#endif
