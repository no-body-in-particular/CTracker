<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Server address" android:paddingTop="8dp" />
        <EditText android:id="@+id/host" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="tracker.example.com"
            android:inputType="textUri" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Port" android:paddingTop="8dp" />
        <EditText android:id="@+id/port" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="9000" android:inputType="number" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Device id (16 digits, not a real IMEI)" android:paddingTop="8dp" />
        <EditText android:id="@+id/imei" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="0000000000000001"
            android:inputType="number" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Report interval (seconds)" android:paddingTop="8dp" />
        <EditText android:id="@+id/interval" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="600" android:inputType="number" />

        <CheckBox android:id="@+id/shell" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp"
            android:text="Allow remote shell (needs the token below)" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Shell token (8+ chars)" android:paddingTop="8dp" />
        <EditText android:id="@+id/token" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="a long secret"
            android:inputType="textPassword" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="16dp">
            <Button android:id="@+id/start" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="Start" />
            <Button android:id="@+id/stop" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="Stop" />
        </LinearLayout>

        <TextView android:id="@+id/state" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp"
            android:textStyle="bold" android:text="Stopped" />
    </LinearLayout>
</ScrollView>
